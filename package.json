{
  "name": "vision-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-wasm.mjs && vite",
    "build": "node scripts/sync-wasm.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "wrangler pages deploy dist --project-name vision-tracker",
    "test": "tsx --test test/*.test.ts",
    "prepare": "node scripts/sync-wasm.mjs",
    "shoot": "node test/harness/shoot.mjs",
    "build:cjk": "node scripts/build-cjk-subset.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
